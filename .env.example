# Copy to .env (never commit .env). Values are read from the environment only when a collector needs them.
# YOUTUBE_API_KEY=
# Identify yourself to the sites/APIs you query (Wikimedia asks for contact details):
# MARKET_SIGNALS_USER_AGENT=market-signals-research/0.1 (you@example.com)
# GOOGLE_TRENDS_API_KEY=
# Optional: store data outside the repo (absolute or relative to the project root).
# MARKET_SIGNALS_DATA_DIR=data
